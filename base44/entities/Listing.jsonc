{
  "name": "Listing",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "team": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "competition": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "card_set": {
      "type": "string"
    },
    "card_number": {
      "type": "string"
    },
    "parallel": {
      "type": "string"
    },
    "variation": {
      "type": "string"
    },
    "is_autograph": {
      "type": "boolean",
      "default": false
    },
    "is_patch": {
      "type": "boolean",
      "default": false
    },
    "is_rookie": {
      "type": "boolean",
      "default": false
    },
    "is_limited_edition": {
      "type": "boolean",
      "default": false
    },
    "serial_number": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "Mint",
        "Near Mint",
        "Excellent",
        "Very Good",
        "Good",
        "Fair",
        "Poor"
      ]
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "shipping_cost": {
      "type": "number",
      "default": 0
    },
    "international_shipping": {
      "type": "boolean",
      "default": false
    },
    "offers_allowed": {
      "type": "boolean",
      "default": false
    },
    "is_auction": {
      "type": "boolean",
      "default": false
    },
    "auction_end_date": {
      "type": "string",
      "format": "date-time"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "sold",
        "paused",
        "deleted"
      ],
      "default": "draft"
    },
    "category": {
      "type": "string",
      "enum": [
        "Singles",
        "Lots",
        "Boxes",
        "Packs",
        "Cases",
        "Memorabilia"
      ]
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "favorites_count": {
      "type": "number",
      "default": 0
    },
    "seller_name": {
      "type": "string"
    },
    "seller_avatar": {
      "type": "string"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "needs_review": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "player_name",
    "price"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
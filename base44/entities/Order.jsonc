{
  "name": "Order",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "listing_title": {
      "type": "string"
    },
    "listing_image": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "buyer_id": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "shipping_cost": {
      "type": "number"
    },
    "tax": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "shipped",
        "delivered",
        "completed",
        "cancelled",
        "returned",
        "refunded"
      ],
      "default": "pending"
    },
    "tracking_number": {
      "type": "string"
    },
    "shipping_address": {
      "type": "object",
      "additionalProperties": true
    },
    "payment_intent_id": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "coupon_code": {
      "type": "string"
    }
  },
  "required": [
    "listing_id",
    "seller_id",
    "total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.buyer_id": "{{user.id}}"
        },
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
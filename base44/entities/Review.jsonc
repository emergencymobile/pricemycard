{
  "name": "Review",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "comment": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_avatar": {
      "type": "string"
    }
  },
  "required": [
    "listing_id",
    "seller_id",
    "rating"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}